# Backend only. Replace the NAS placeholder with your actual IP or hostname.
APP_URL=https://your-password-service.example.com
DATABASE_URL=postgresql://user:password@localhost:5432/password_service
TRUENAS_URL=https://YOUR_TRUENAS_IP_OR_HOSTNAME
TRUENAS_API_KEY=REPLACE_LOCALLY_DO_NOT_COMMIT
SESSION_SECRET=REPLACE_LOCALLY_WITH_AT_LEAST_48_RANDOM_CHARACTERS
PASSWORD_LINK_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
# Only enable behind the supplied Caddy (app must not be directly reachable).
TRUST_PROXY=false
# For private CA certificates mount the CA and set NODE_EXTRA_CA_CERTS.
# Compose mounts ./nas-ca read-only at /usr/local/share/ca-certificates/nas.
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/nas/nas-ca.crt
# Compose only: set these locally, never commit their actual values.
POSTGRES_PASSWORD=REPLACE_LOCALLY
APP_HOST=your-password-service.example.com
